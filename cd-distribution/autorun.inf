[AutoRun]
open=setup-windows.bat
icon=icon.ico
label=FOGNET-X Fog Computing Platform
action=Install FOGNET-X

[Content]
Title=FOGNET-X Complete Distribution
Description=Fog Computing Platform for IoT - Real-time Monitoring & ML
Version=1.0.0

[Install]
Windows=setup-windows.bat
Linux=setup-linux.sh
Docker=docker-compose.yml

[Documentation]
