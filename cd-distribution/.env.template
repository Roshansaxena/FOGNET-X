# FOGNET-X Environment Configuration Template
# Copy this file to .env and fill in your values

# ==========================================
# APPLICATION SECRETS (Change these!)
# ==========================================
FLASK_SECRET_KEY=change-this-to-random-secret-key
JWT_SECRET_KEY=change-this-to-random-jwt-secret
JWT_ACCESS_TOKEN_EXPIRES=86400

# ==========================================
# DATABASE
# ==========================================
DB_PATH=./fognetx.db
# For PostgreSQL:
# DB_TYPE=postgresql
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=fognetx
# DB_USER=postgres
# DB_PASSWORD=yourpassword

# ==========================================
# MQTT BROKER
# ==========================================
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# ==========================================
# CORS & SERVER
# ==========================================
CORS_ORIGIN=http://localhost:3000
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# ==========================================
# EMAIL ALERTS (Gmail Example)
# ==========================================
# Leave blank to disable email alerts

# Your email address (sender)
EMAIL_SENDER=

# Gmail App Password (NOT your regular password!)
# How to get: https://support.google.com/accounts/answer/185833
EMAIL_PASSWORD=

# Email to receive alerts (can be same as sender)
EMAIL_RECEIVER=

# SMTP Server (Gmail defaults)
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=465

# ==========================================
# TELEGRAM ALERTS
# ==========================================
# Leave blank to disable Telegram alerts

# Get token from @BotFather on Telegram
TELEGRAM_TOKEN=

# Your chat ID (message @userinfobot on Telegram to get it)
TELEGRAM_CHAT_ID=

# ==========================================
# GOOGLE OAUTH (Optional)
# ==========================================
# Get from: https://console.cloud.google.com/apis/credentials

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# ==========================================
# ALERT SETTINGS
# ==========================================
ALERT_COOLDOWN=300  # Seconds between alerts (default: 5 minutes)
ENABLE_EMAIL_ALERTS=true
ENABLE_TELEGRAM_ALERTS=true

# ==========================================
# SENSOR THRESHOLDS (Defaults)
# ==========================================
TEMP_WARNING=35
TEMP_CRITICAL=45
TEMP_EMERGENCY=55

GAS_WARNING=400
GAS_CRITICAL=700
GAS_EMERGENCY=900

HUMIDITY_WARNING=80
HUMIDITY_CRITICAL=90

# ==========================================
# LOGGING
# ==========================================
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR
LOG_FILE=./logs/fognetx.log

# ==========================================
# ML MODEL (Optional)
# ==========================================
RISK_MODEL_PATH=./risk_model.pkl
ENABLE_ML_DECISIONS=false

# ==========================================
# NOTES
# ==========================================
# 1. Never commit .env file to Git
# 2. Use strong random strings for secrets
# 3. Test email/Telegram before production
# 4. Keep API keys secure!
